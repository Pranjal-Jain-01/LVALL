# API base URL — matches backend PORT
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Portal mode — determines which portal renders at /
# Options: admin | field-pwa | verifier | public
VITE_PORTAL_MODE=admin

# Feature flags (mirrors backend)
VITE_FEATURE_PUBLIC_RECEIPTS=true
VITE_FEATURE_GIFT_AID=true
VITE_FEATURE_80G=true

# Sentry DSN (optional — leave blank for dev)
VITE_SENTRY_DSN=
