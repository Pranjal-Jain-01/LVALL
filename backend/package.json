{
  "name": "loveall-transparency-ledger-api",
  "version": "0.1.0",
  "description": "LoveAll Transparency Ledger — multi-tenant NGO financial transparency API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:acceptance": "jest tests/acceptance --runInBand --forceExit",
    "db:migrate": "node scripts/db-migrate.js",
    "db:seed": "node scripts/db-seed.js",
    "db:test": "node scripts/db-test.js",
    "lint": "eslint src tests --ext .js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.3.1",
    "morgan": "^1.10.0",
    "uuid": "^10.0.0",
    "joi": "^17.13.3",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.4.5",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "nodemon": "^3.1.4",
    "eslint": "^9.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
