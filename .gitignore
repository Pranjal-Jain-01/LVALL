# ── Node.js ───────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ── Build outputs ─────────────────────────────────────────────
dist/
build/
.vite/

# ── Environment files (NEVER commit secrets) ──────────────────
.env
.env.local
.env.*.local
