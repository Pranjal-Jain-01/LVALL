!.env.example
!backend/.env.example
!frontend/.env.example

# ── Uploads & local object storage ───────────────────────────
backend/uploads/
backend/keys/

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo

# ── Testing ───────────────────────────────────────────────────
coverage/
.nyc_output/
jest.config.local.js

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDEs ──────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log

# ── Misc ──────────────────────────────────────────────────────
*.pem
*.key
!backend/src/config/kms.js   # keep the stub, not real keys
